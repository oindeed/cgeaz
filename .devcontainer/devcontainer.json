{
  // The lab workstation as code: every tool the course uses, version-pinned, in the
  // browser. Open the fork in GitHub Codespaces and nothing installs on your machine.
  // Versions match what docs/SETUP.md validated and what tier0.yml runs in CI.
  "name": "cgeaz lab workstation",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.9.8",
      "tflint": "0.53.0"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-python.python"
      ]
    }
  }
}
